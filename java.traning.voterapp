package day2;

import java.util.Scanner;

public class voterapp {
    public static void main(String[] args) {
        String name ="", pan = "", email = "", aadhaar="", mobile = "";
        boolean isValid = true;
        Scanner venky = new Scanner(System.in);
        System.out.println("enter the name");
        name = venky.next();
        System.out.println("enter the email");
        email = venky.next();
        System.out.println("enter the mobile number");
        mobile = venky.next();
        System.out.println("enter the aadhaar number");
        aadhaar = venky.next();
        System.out.println("enter the pan number");
        pan = venky.next();
        if(!name.matches("^[A-Za-z]{5,}$"))
        {isValid=false;System.out.println("invaild name");}
        if(!email.matches("^[A-Za-z0-9.-]{2,}@[A-Za-z]{3,}+\\.[a-z]{2,}$"))
        {isValid=false;System.out.println("invaild eamil");}
        if(!mobile.matches("^[0-9]{10}$"))
        {isValid=false;System.out.println("invaild mobile number");}
        if(!aadhaar.matches("^[0-9]{12}$"))
        {isValid=false;System.out.println("invaild addhaaar numbar");}
        if(!pan.matches("^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
        {isValid=false;System.out.println("invaild pan number");}
        if(isValid)
            System.out.println(name+" voter application futher upadates send to "+mobile+" or "+email);
        else System.out.println("application rejected");
     venky.close();


    }
}
