#include <stdio.h>
int main() {
    int days,daily_expenses;
    scanf("%d",&days);
    int count=0,sum=0;
    for(int i=0;i<days;i++){
        scanf("%d",&daily_expenses);
        if(daily_expenses>1000){
            count++;
             }
             sum=sum+daily_expenses;
             }
             printf("%d\n",count);
             printf("%d",sum);
    return 0;
}
