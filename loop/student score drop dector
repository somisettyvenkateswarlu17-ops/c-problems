int main() {
    int num,marks;
    scanf("%d",&num);
    int sum=0,count=0;
    for(int i=0;i<num;i++){
        scanf("%d",&marks);
        if(marks<40){
            count++;

        }
        sum=sum+marks/5;
    }
    printf("failed subjects: %d\n",count);
    printf("Average score: %d",sum);
    return 0;
}
