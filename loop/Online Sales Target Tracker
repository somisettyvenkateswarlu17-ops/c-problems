#include <stdio.h>
int main() {
    int n,daily_revenue;
    scanf("%d",&n);
    int sum=0,count=0;
    for(int i=0;i<n;i++){
        scanf("%d",&daily_revenue);
        if(daily_revenue>50000){
           count++;
        }
        sum=sum+daily_revenue;
    }
       printf("Total revenue: %d\n",sum);
       printf(" Tardet Days: %d",count);
    
    return 0;
}
